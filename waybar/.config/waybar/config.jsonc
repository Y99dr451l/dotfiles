{
	"layer": "top",
	"position": "top",
	"modules-left": [
		"hyprland/workspaces",
		"hyprland/window"
	],
	"modules-center": [
		"custom/swaync",
		"mpris",
		"cava"
	],
	"modules-right": [
		"custom/idle",
		"custom/anims",
		"network",
		"pulseaudio",
		"memory",
		"cpu",
		"custom/gpu",
		"battery",
		"custom/clock"
	],

	// LEFT
	"hyprland/workspaces": {
		"format": "{name} {windows}",
		"all-outputs": true,
		"show-special": true,
		"workspace-taskbar": {
			"enable": true,
			"update-active-window": true,
			"format": "{icon}",
			"icon-size": 20
		},
		"on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\", on_current_monitor = true })'",
		"on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\", on_current_monitor = true })'"
	},
	"hyprland/window": {
		"icon": true,
		"icon-size": 20,
		"format": "{title}",
		"max-length": 48
	},
	// CENTER
	"mpris": {
		"interval": 1,
		"format": "{status_icon} {player_icon} <b> {artist}</b> {title}",
		"tooltip": true,
		"tooltip-format": "{player}\n{artist} - {title}\n{album}",
		"title-len": 72,
		"status-icons": { "playing": "󰐊", "paused": "󰏤", "stopped": "󰓛" },
		"player-icons": { "firefox": "󰈹", "spotify": "", "default": "" }
	},
	"cava": {
		"method": "pipewire",
		"framerate": 30,
		"autosens": 0,
		"sensitivity": 2,
		"bars": 16,
		"lower_cutoff_freq": 35,
		"higher_cutoff_freq": 10000,
		"sleep_timer": 2,
		"hide_on_silence": true,
		"stereo": true,
		"bar_delimiter": 0,
		"noise_reduction": 0.77,
		"input_delay": 2,
		"format-icons": [" ", "▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
		"actions": { "on-click-right": "mode" }
	},
	"custom/swaync": {
		"tooltip": false,
		"format": "{0} {icon}",
		"format-icons": {
			"notification": "󱅫",
			"none": "󰂜",
			"dnd-notification": "󰂠",
			"dnd-none": "󰪓",
			"inhibited-notification": "󰂛",
			"inhibited-none": "󰪑",
			"dnd-inhibited-notification": "󰂛",
			"dnd-inhibited-none": "󰪑"
		},
		"return-type": "json",
		"exec-if": "which swaync-client",
		"exec": "swaync-client -swb",
		"on-click": "swaync-client -t -sw",
		"on-click-right": "swaync-client -d -sw",
		"escape": true
	},
	// RIGHT
	"network" : {
		"interval": 5,
		"format": "{bandwidthDownBytes}↓ {bandwidthUpBytes}↑",
		"format-disconnected": "x",
		"tooltip": true,
		"max-length": 20,
	},
	"pulseaudio": {
		"format": "{format_source}{icon}{volume}%",
		"format-muted": "{format_source}󰖁",
		"format-icons": ["󰕿 ", "󰖀 ", "󰕾 "],
		"format-source": "",
		"format-source-muted": " ",
		"tooltip": true,
		"scroll-step": 5.0
	},
	"memory": {
		"interval": 5,
		"tooltip": true,
		"format": "  {percentage}%",
		"format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
		"states": { "warning": 80, "critical": 90 }
	},
	"cpu": {
		"interval": 5,
		"tooltip": true,
		"format": "  {usage}%",
		// "format": "{icon} {usage}%",
		// "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
		"states": { "warning": 80, "critical": 90 }
	},
	"battery": {
		"interval": 20,
		"format": "{icon} {capacity}%",
		"format-icons": ["󰁻", "󰁽", "󰁿", "󰂁", "󰁹"],
		"states": { "warning": 20, "critical": 10 },
		"events": {
			"on-discharging-warning": "notify-send -u normal 'Low Battery'",
			"on-discharging-critical": "notify-send -u critical 'Very Low Battery'",
			"on-charging-100": "notify-send -u normal 'Battery Full!'",
			"on-discharging": "notify-send -u normal 'Power Switch' Discharging",
			"on-charging": "notify-send -u normal 'Power Switch' Charging'"
		},
	},
	"custom/clock": {
		"interval": 5,
		"tooltip": true,
		"return-type": "json",
		"format": " {text} ",
		"exec": "~/.config/waybar/scripts/clock.sh"
	},
	"custom/anims": {
		"signal": 5,
		"interval": "once",
		"return-type": "json",
		"format": "{icon}",
		"format-icons": ["󰪐", ""],
		"hide-empty-text": false,
		"tooltip": false,
		"exec": "~/.config/waybar/scripts/anims.sh"
	},
	"custom/idle": {
		"signal": 6,
		"interval": "once",
		"return-type": "json",
		"format": "{icon}",
		"format-icons": ["⟳", ""],
		"hide-empty-text": false,
		"tooltip": false,
		"exec": "~/.config/waybar/scripts/idle.sh"
	},
	"custom/brightness": {
		"signal": 8,
		"interval": 3600,
		"return-type": "json",
		"format": " {text} ",
		"exec": "~/.config/waybar/scripts/brightness.sh get",
		"on_click_middle": "~/.config/waybar/scripts/brightness.sh sync",
		"on-scroll-up": "~/.config/waybar/scripts/brightness.sh up",
		"on-scroll-down": "~/.config/waybar/scripts/brightness.sh down",
		"on-click": "~/.config/waybar/scripts/brightness.sh offset-",
		"on-click-right": "~/.config/waybar/scripts/brightness.sh offset+"
	},
	"custom/gpu": {
		"interval": 5,
		"return-type": "",
		"format": "󰋁  {}%",
		"exec": "nvidia-smi --query-gpu=utilization.gpu | grep -v gpu | cut -d' ' -f1",
		"states": { "warning": 80, "critical": 90 }
	}
}