{
	"layer": "top",
	"position": "top",
	// "height": "30",
	// "width": "2560",
	"modules-left": [
		"hyprland/workspaces"
	],
	"modules-center": [
		"hyprland/window"
	],
	"modules-right": [
		"systemd-failed-units",
		"network",
		"cpu",
		"battery",
		"clock"
	],

	"hyprland/workspaces": {
		"format": "{icon} {windows}",
		"workspace-taskbar": {
			"enable": true,
			"update-active-window": true,
			"format": "{icon}"
		}
	},
	"hyprland/window": {
		"icon": true,
		"icon-size": 18
	},
	"systemd-failed-units": {
		"format-ok": "ok ",
		"hide-on-ok": false
	},
	"network" : {
		"interval": 5,
		"interface": "wlan0",
		"format": "{bandwidthDownBytes}↓ {bandwidthUpBytes}↑",
		"format-disconnected": "x",
		"max-length": 20
	},
	"cpu": {
		"interval": 5,
		"format": "{usage}% {icon0}{icon1}{icon2}{icon3}{icon4}{icon5}{icon6}{icon7}{icon8}{icon9}{icon10}{icon11}{icon12}{icon13}{icon14}{icon15}",
		"format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
	},
}