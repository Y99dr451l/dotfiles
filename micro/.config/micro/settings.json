{
    "autosu": true,
    "colorscheme": "twilight",
    "diffgutter": true,
    "divchars": "-|",
    "eofnewline": false,
    "hltaberrors": true,
    "hltrailingws": true,
    "literate": false,
    "lsp.autocompleteDetails": true,
    "lsp.formatOnSave": false,
    "lsp.server": "cpp=clangd, lua=lua-language-server, json=vscode-json-language-server --stdio, rust=rust-analyzer, wgsl=wgsl-analyzer",
    "lsp.tabcompletion": true,
    "matchbracestyle": "highlight",
    "mkparents": true,
    "rmtrailingws": true,
    "scrollbar": true
}
